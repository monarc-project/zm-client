        {
            "name": "Jérôme Lombardi",
            "email": "jerome.lombardi@cases.lu"
        },
        {
            "name": "Juan Rocha",
            "email": "juan.rocha@cases.lu"
        },
        {
            "name": "Cédric Bonhomme",
            "email": "cedric.bonhomme@cases.lu"
        },
