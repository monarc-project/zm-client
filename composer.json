            "email": "ruslan.baidan@cases.lu"
        }
    ],
    "require": {
        "php": ">=8.4.27 <8.5.0",
        "ext-intl": "*",
        "ext-imagick": "*",
        "ext-json": "*",
        "ext-bcmath": "*",
        "ext-openssl": "*",
        "ext-posix": "*",
        "doctrine/doctrine-orm-module": "^6.3",
        "monarc/core": "^2.15@dev",
        "robmorgan/phinx": "^0.13.4",
        "laminas/laminas-di": "^3.1",
        "laminas/laminas-mvc": "^3.1",
        "laminas/laminas-permissions-rbac": "^3.0",
        "laminas/laminas-filter": "^2.9",
        "laminas/laminas-inputfilter": "^2.10",
        "symfony/console": "^6.4",
        "guzzlehttp/guzzle": "^7.11",
        "phpoffice/phpword": "^0.18.1",
        "laminas/laminas-mvc-middleware": "^2.2",
        "laminas/laminas-captcha": "^2.18",
        "guzzlehttp/psr7": "^2.11"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Monarc\\FrontOffice\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-feature/php84": "2.15.x-dev"
        }
    },
    "scripts": {
        "phpcs": "phpcs --standard=PSR2 src/"
    },
    "bin": ["bin/console"],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "allow-plugins": {
            "ocramius/package-versions": true
        }
    }
}
